# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID. You can find this by messaging @userinfobot or @IdBot on Telegram.
# Multiple IDs can be separated by commas (e.g. 12345678,98765432)
ALLOWED_USER_IDS=your_numeric_telegram_user_id_here

# Ollama settings
OLLAMA_MODEL=llama3.1:latest
OLLAMA_VISION_MODEL=llama3.2-vision:latest

# SQLite database file path
DATABASE_PATH=assistant.db

# Path to your Obsidian vault (notes are saved here)
OBSIDIAN_VAULT_PATH=/path/to/your/vault
